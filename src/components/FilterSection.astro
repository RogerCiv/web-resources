---
import { categoriaLabels, type CollectionName } from "../lib/resources";
import type { RecursoCompleto } from "../lib/resources";

interface Props {
  categories: CollectionName[];
  allResources: RecursoCompleto[];
}

const { categories, allResources } = Astro.props;

const counts = (cat: CollectionName) => allResources.filter((r) => r.categoria === cat).length;
const activeCategories = categories.filter((c) => counts(c) > 0);

const btn =
  "category-btn flex min-h-11 shrink-0 cursor-pointer items-center justify-between gap-3 whitespace-nowrap rounded-full border border-border px-4 text-left text-base font-medium text-text-muted transition-all hover:border-border-hover hover:text-text aria-selected:border-accent aria-selected:bg-accent-dimmed aria-selected:text-accent lg:w-full lg:rounded-l-none lg:rounded-r-xl lg:border-0 lg:border-l-[3px] lg:border-l-transparent lg:hover:bg-bg-card aria-selected:lg:border-l-accent";
---

<aside id="categorias" aria-label="Categorías" class="lg:sticky lg:top-24 lg:w-60 lg:shrink-0">
  <h2 class="mb-4 hidden font-mono text-xs uppercase tracking-[0.12em] text-text-dimmed lg:block">Categorías</h2>
  <div id="category-filters" class="-mx-6 flex gap-2 overflow-x-auto px-6 pb-2 lg:mx-0 lg:flex-col lg:gap-0.5 lg:overflow-visible lg:px-0 lg:pb-0" role="tablist">
    <button data-category="all" role="tab" aria-selected="true" class={btn}>
      Todos
      <span class="font-mono text-xs tabular-nums">{allResources.length}</span>
    </button>
    {
      activeCategories.map((cat) => (
        <button data-category={cat} role="tab" aria-selected="false" class={btn}>
          {categoriaLabels[cat] || cat}
          <span class="font-mono text-xs tabular-nums">{counts(cat)}</span>
        </button>
      ))
    }
  </div>
</aside>
