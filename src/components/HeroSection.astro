---
interface Props {
  totalResources: number;
  names: string[];
}
const { totalResources, names } = Astro.props;
---

<section class="relative mx-auto max-w-7xl px-6 pt-16 pb-20">
  <div
    class="spin-slow absolute right-6 top-10 hidden h-44 w-44 rotate-[-12deg] items-center justify-center rounded-full bg-accent text-center text-bg lg:flex"
    aria-hidden="true"
  >
    <div class="font-display font-extrabold leading-[0.9]">
      <div class="text-6xl tracking-tighter">{totalResources}</div>
      <div class="mt-1 text-sm">recursos curados</div>
    </div>
  </div>

  <p class="inline-flex items-center gap-2.5 rounded-full border border-accent-border bg-accent-dimmed px-4 py-1.5 text-sm font-medium text-accent">
    <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
    Directorio para desarrolladores
  </p>

  <h1 class="mt-7 max-w-5xl font-display text-[clamp(3rem,9.5vw,8.5rem)] font-extrabold leading-[0.88] tracking-[-0.045em] text-text text-balance">
    Todo lo que necesitas para
    <span class="text-accent">desarrollar</span>
    <span class="text-transparent [-webkit-text-stroke:2px_var(--color-text)]">la web.</span>
  </h1>

  <p class="mt-8 max-w-xl text-lg leading-relaxed text-text-muted text-pretty sm:text-xl">
    Frameworks, herramientas, APIs y librerías elegidos a mano. Sin ruido, sin relleno: encuentra lo que buscas en segundos.
  </p>

  <search class="mt-10 max-w-3xl">
    <label
      for="search-input"
      class="group flex cursor-text items-center gap-4 rounded-[20px] border border-border-hover bg-bg-card py-2.5 pr-3 pl-6 transition-all focus-within:border-accent focus-within:ring-[6px] focus-within:ring-accent/10"
    >
      <span class="sr-only">Buscar recursos</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-accent" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder="Busca Astro, Tailwind, Supabase…"
        autocomplete="off"
        class="min-w-0 flex-1 bg-transparent py-3.5 text-lg text-text placeholder:text-text-dimmed focus:outline-none sm:text-xl"
      />
      <kbd class="hidden rounded-lg border border-border-hover bg-bg-surface px-3 py-1.5 font-mono text-sm text-text-muted sm:inline-block">/</kbd>
    </label>
  </search>
</section>

<div
  class="-mx-5 mb-4 -rotate-[1.2deg] overflow-hidden border-y border-border bg-accent text-bg"
  aria-hidden="true"
>
  <div class="marquee-track flex whitespace-nowrap py-4 font-display text-3xl font-extrabold tracking-tight">
    {[0, 1].map(() => names.map((n) => (
      <span class="px-7">{n} <span class="pl-7 opacity-45">✦</span></span>
    )))}
  </div>
</div>

<script>
  // Focus search on "/" key
  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement?.tagName !== "INPUT") {
      e.preventDefault();
      document.getElementById("search-input")?.focus();
    }
  });
</script>
